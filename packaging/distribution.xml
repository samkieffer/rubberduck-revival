<?xml version="1.0" encoding="utf-8"?>
<!-- Installer layout for scripts/make_dmg.sh; @VERSION@ and @ID@ are filled in by the script. -->
<installer-gui-script minSpecVersion="2">
    <title>Rubber Duck Revival @VERSION@</title>
    <welcome file="welcome.html" mime-type="text/html"/>
    <conclusion file="conclusion.html" mime-type="text/html"/>
    <options customize="allow" require-scripts="false" hostArchitectures="arm64,x86_64"/>
    <domains enable_localSystem="true" enable_anywhere="false" enable_currentUserHome="false"/>
    <allowed-os-versions>
        <os-version min="11.0"/>
    </allowed-os-versions>

    <choices-outline>
        <line choice="au"/>
        <line choice="vst3"/>
        <line choice="app"/>
    </choices-outline>
    <choice id="au" title="Audio Unit"
            description="Pour Ableton Live, Logic Pro, GarageBand… Installé dans /Library/Audio/Plug-Ins/Components.">
        <pkg-ref id="@ID@.au"/>
    </choice>
    <choice id="vst3" title="VST3"
            description="Pour Ableton Live, Bitwig, Reaper… Installé dans /Library/Audio/Plug-Ins/VST3.">
        <pkg-ref id="@ID@.vst3"/>
    </choice>
    <choice id="app" title="Application autonome"
            description="Rubber Duck Revival sans logiciel hôte, dans /Applications.">
        <pkg-ref id="@ID@.app"/>
    </choice>

    <pkg-ref id="@ID@.au" version="@VERSION@" onConclusion="none">au.pkg</pkg-ref>
    <pkg-ref id="@ID@.vst3" version="@VERSION@" onConclusion="none">vst3.pkg</pkg-ref>
    <pkg-ref id="@ID@.app" version="@VERSION@" onConclusion="none">app.pkg</pkg-ref>
</installer-gui-script>
